{
  "name": "Lector MD",
  "short_name": "Lector MD",
  "description": "Lee, escucha y edita archivos Markdown.",
  "lang": "es",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F2F4F1",
  "theme_color": "#F2F4F1",
  "categories": ["productivity", "utilities", "books"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["text/markdown", "text/x-markdown", "text/plain", ".md", ".markdown", "application/octet-stream"] }
      ]
    }
  },
  "file_handlers": [
    { "action": "./", "accept": { "text/markdown": [".md", ".markdown"] } }
  ]
}
